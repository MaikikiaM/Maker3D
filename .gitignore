# ==============================================================================
# Plantilla Maestra .gitignore (Proteccion contra archivos > 50 MB, binarios y secretos)
# ==============================================================================

# Entornos virtuales y dependencias masivas
node_modules/
build/
dist/
target/
.gradle/
.paper-remapped/

# Binarios y compilados no versionables
*.pdf
*.stl
*.3mf
*.obj
*.ply
*.glb
*.apk
*.aab
*.jar
*.npy
*.npz
*.iso
*.img

# Python cache
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Secretos y credenciales
.env
.env.*
!.env.example
*token*
*.key
*.pem
*.p12

# Archivos de depuracion LaTeX
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.vrb
*.synctex.gz

# Archivos temporales de sistema
.DS_Store
Thumbs.db
*.tmp
*.temp
*~

# Especificas del proyecto
*.stl
*.3mf
*.obj
*.ply
*.glb
*.npy
*.npz
*.png
*.jpg
*.jpeg
!Visores-HTML/*.html
Visores-HTML/*-raw.html
Visores-HTML/*-uncompressed.html
Visores-HTML/catan-bioma-montana-hero360-v05-macro8k.html
Visores-HTML/catan-bioma-montana-hero360-v06-full8k.html
Visores-HTML/catan-bioma-montana-hero360-v07-shrubs8k.html
Tableros-Catan/losetas/*/versiones/
Tableros-Catan/losetas/*/work/**
Tableros-Catan/losetas/*/work_*/**
!Tableros-Catan/losetas/*/work/
!Tableros-Catan/losetas/*/work/**/
!Tableros-Catan/losetas/*/work/**/*.json
!Tableros-Catan/losetas/*/work/**/*.md
!Tableros-Catan/losetas/*/work_*/
!Tableros-Catan/losetas/*/work_*/**/
!Tableros-Catan/losetas/*/work_*/**/*.json
Tableros-Catan/assets/polyhaven/rocks/
*.zip
tools/smoke_test_out/
*.step
*.stp
*.blend
*.blend1
*.exr
*.hdr
*.ktx2
*.gcode
*.preview.html
*.pdf
**/work/live_telemetry.json
**/work/live_console.log
**/_colab_tmp/
