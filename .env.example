# Claves opcionales para inferencia 3D Cloud (nunca subir .env real a Git)
# Copia este archivo como ".env" en la raíz de Maker3D si deseas usar proveedores de pago.
# El flujo local (Blender, build123d, OpenSCAD, Landlab, Bambu CLI, Meshopt/WebP) funciona sin claves ($0).

# fal.ai (TRELLIS.2, Hunyuan3D 3.1, Depth Pro): https://fal.ai
FAL_KEY=

# Replicate: https://replicate.com
REPLICATE_API_TOKEN=

# Hugging Face (opcional para aumentar límite de ZeroGPU / espacios privados): https://huggingface.co/settings/tokens
HF_TOKEN=

# Plataformas SaaS opcionales
MESHY_API_KEY=
TRIPO_API_KEY=
